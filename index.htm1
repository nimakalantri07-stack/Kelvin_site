</p>

</div>


<div class="service">

<div class="part-icon">🔧</div>

<h3>نصب کولر گازی</h3>

<p>
اجرای اصولی نصب و اجرای لوله مسی
با رعایت استانداردهای نصب.
</p>

</div>


<div class="service">

<div class="part-icon">⚙️</div>

<h3>شارژ گاز</h3>

<p>
بررسی فشار و شارژ گاز مناسب سیستم
بر اساس مدل دستگاه.
</p>

</div>

</div>
</div>
</section>


<!-- رزرو -->

<section id="booking">

<div class="container">

<div class="section-title">

<h2>درخواست نصب و رزرو زمان</h2>

<p>
زمان مناسب خود را انتخاب کنید
</p>

</div>

<div class="booking">

<div class="form-grid">

<input type="text"
placeholder="نام و نام خانوادگی">

<input type="tel"
placeholder="شماره موبایل">

<input type="date">

<select>

<option>
نوع کولر را انتخاب کنید
</option>

<option>
اسپلیت دیواری
</option>

<option>
ایستاده
</option>

<option>
داکت اسپلیت
</option>

</select>

<input class="full"
type="text"
placeholder="آدرس محل نصب">

<textarea class="full"
placeholder="توضیحات و درخواست شما"></textarea>

</div>

<br>

<h3>
انتخاب ساعت
</h3>

<br>

<div class="time-slots">

<button class="time-slot">
۸ تا ۱۰
</button>

<button class="time-slot">
۱۰ تا ۱۲
</button>

<button class="time-slot">
۱۴ تا ۱۶
</button>

<button class="time-slot">
۱۶ تا ۱۸
</button>

</div>

<br>

<div class="buttons">

<a class="btn btn-primary" href="#">
ارسال درخواست
</a>

<a class="btn btn-outline" href="#">
ارسال با پیامک
</a>

<a class="btn btn-outline" href="#">
ارسال با واتساپ
</a>

</div>

</div>
</div>
</section>


<!-- تماس -->

<section id="contact">

<div class="container">

<div class="section-title">

<h2>کلوین را پیدا کنید</h2>

<p>
فروش و خدمات کولر گازی
</p>

</div>

<div class="contact-box">


<div class="contact-card">

<h3>
اطلاعات فروشگاه
</h3>

<p>
📍 زنجان، خرمدره، جنب بانک ملی
</p>

<p>
📷 @kelvin_cooling
</p>

<a class="btn btn-primary" href="#">
مسیریابی تا فروشگاه
</a>

</div>


<div class="contact-card">

<h3>
ارتباط با کلوین
</h3>

<p>
برای خرید کولر، استعلام قیمت
یا رزرو نصب با ما در ارتباط باشید.
</p>

<a class="btn btn-primary" href="#booking">
درخواست نصب
</a>

</div>

</div>
</div>
</section>


<footer>

<div class="container">

© 2026 KELVIN — فروش و خدمات کولر گازی

</div>

</footer>


<script>

let selectedBrand="all";
let selectedCapacity="all";


function filterBrand(brand,element){

selectedBrand=brand;

document
.querySelectorAll(".brand-card")
.forEach(card=>{
card.classList.remove("active");
});

element.classList.add("active");

updateProducts();

}


function filterCapacity(capacity,element){

selectedCapacity=capacity;

document
.querySelectorAll(".filter-btn")
.forEach(btn=>{
btn.classList.remove("active");
});

element.classList.add("active");

updateProducts();

}


function updateProducts(){

const products=
document.querySelectorAll(".product");

products.forEach(product=>{

const brand=
product.dataset.brand;

const capacity=
product.dataset.capacity;

const brandOK=
selectedBrand==="all" ||
brand===selectedBrand;

const capacityOK=
selectedCapacity==="all" ||
capacity===selectedCapacity;

if(brandOK && capacityOK){

product.style.display="block";

}else{

product.style.display="none";

}

});

}


document
.querySelectorAll(".time-slot")
.forEach(slot=>{

slot.addEventListener("click",function(){

document
.querySelectorAll(".time-slot")
.forEach(x=>{
x.classList.remove("selected");
});

this.classList.add("selected");

});

});

</script>

</body>
</html>
