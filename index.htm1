</div>


<div class="product"
data-brand="general-gold"
data-capacity="24000">

<div class="product-image">

<img src="images/general-gold-24000.jpg"
alt="کولر گازی">

</div>

<div class="product-content">

<h3>کولر گازی جنرال گلد</h3>

<div class="specs">

<div>ظرفیت: ۲۴۰۰۰</div>

<div>نوع: اسپلیت دیواری</div>

<div>کمپرسور: بسته به مدل</div>

<div>گاز مبرد: بسته به مدل</div>

</div>

<div class="price">
استعلام قیمت
</div>

</div>
</div>


<div class="product"
data-brand="lg"
data-capacity="18000">

<div class="product-image">

<img src="images/lg-18000.jpg"
alt="کولر گازی">

</div>

<div class="product-content">

<h3>کولر گازی ال‌جی</h3>

<div class="specs">

<div>ظرفیت: ۱۸۰۰۰</div>

<div>نوع: اسپلیت دیواری</div>

<div>کمپرسور: بسته به مدل</div>

<div>گاز مبرد: بسته به مدل</div>

</div>

<div class="price">
استعلام قیمت
</div>

</div>
</div>


<div class="product"
data-brand="hisense"
data-capacity="24000">

<div class="product-image">

<img src="images/hisense-24000.jpg"
alt="کولر گازی">

</div>

<div class="product-content">

<h3>کولر گازی هایسنس</h3>

<div class="specs">

<div>ظرفیت: ۲۴۰۰۰</div>

<div>نوع: اسپلیت دیواری</div>

<div>کمپرسور: بسته به مدل</div>

<div>گاز مبرد: بسته به مدل</div>

</div>

<div class="price">
استعلام قیمت
</div>

</div>
</div>

</div>
</div>
</section>


<!-- قطعات -->

<section id="parts">

<div class="container">

<div class="section-title">

<h2>لوازم و قطعات کولر گازی</h2>

<p>
قطعات موردنیاز نصب و سرویس
</p>

</div>

<div class="parts">

<div class="part">

<div class="part-icon">〰️</div>

<h3>لوله مسی</h3>

<p>
۱/۴ • ۳/۸ • ۱/۲ • ۵/۸
</p>

</div>


<div class="part">

<div class="part-icon">◉</div>

<h3>عایق لوله</h3>

<p>
سایزهای مختلف
</p>

</div>


<div class="part">

<div class="part-icon">▣</div>

<h3>کاور کمپرسور</h3>

<p>
تمام سایزها
</p>

</div>


<div class="part">

<div class="part-icon">▰</div>

<h3>پایه دیواری</h3>

<p>
۱۲k • ۱۸k • ۲۴k • ۶۰k
</p>

</div>


<div class="part">

<div class="part-icon">⬟</div>

<h3>پایه زمینی</h3>

<p>
لاستیکی و استخوانی
</p>

</div>

</div>
</div>
</section>


<!-- خدمات -->

<section id="services">

<div class="container">

<div class="section-title">

<h2>خدمات کلوین</h2>

<p>
خدمات کامل کولر گازی
</p>

</div>

<div class="services">


<div class="service">

<div class="part-icon">❄️</div>

<h3>سرویس کامل</h3>

<p>
شست‌وشو، بررسی عملکرد، بررسی نشتی
