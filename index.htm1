<button class="filter-btn"
onclick="filterCapacity('12000',this)">
۱۲ هزار
</button>

<button class="filter-btn"
onclick="filterCapacity('18000',this)">
۱۸ هزار
</button>

<button class="filter-btn"
onclick="filterCapacity('24000',this)">
۲۴ هزار
</button>

<button class="filter-btn"
onclick="filterCapacity('30000',this)">
۳۰ هزار
</button>

<button class="filter-btn"
onclick="filterCapacity('36000',this)">
