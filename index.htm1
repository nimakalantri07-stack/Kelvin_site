<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>کلوین | فروش و خدمات کولر گازی</title>

<style>
*{
box-sizing:border-box;
margin:0;
padding:0;
}

body{
font-family:Tahoma,Arial,sans-serif;
background:
radial-gradient(circle at top right,#123d68 0%,#071522 35%,#030910 100%);
color:#fff;
line-height:1.8;
}

.container{
width:92%;
max-width:1200px;
margin:auto;
}

header{
position:sticky;
top:0;
z-index:1000;
background:rgba(3,10,18,.92);
backdrop-filter:blur(12px);
border-bottom:1px solid rgba(255,255,255,.08);
}

.nav{
min-height:72px;
display:flex;
align-items:center;
justify-content:space-between;
}

.logo{
font-size:30px;
font-weight:900;
letter-spacing:3px;
}

.logo span{
color:#159cff;
}

nav a{
color:#ddd;
text-decoration:none;
margin:0 8px;
font-size:14px;
}

.hero{
min-height:570px;
display:flex;
align-items:center;
position:relative;
overflow:hidden;
}

.hero::before{
content:"";
position:absolute;
width:500px;
height:500px;
background:#087edb;
filter:blur(150px);
opacity:.18;
right:-150px;
top:-100px;
}

.hero-content{
position:relative;
z-index:2;
padding:80px 0;
}

.badge{
display:inline-block;
padding:7px 15px;
border:1px solid #1b9cff;
border-radius:30px;
color:#58bdff;
font-size:13px;
margin-bottom:18px;
}

.hero h1{
font-size:48px;
line-height:1.35;
max-width:700px;
}

.hero h1 span{
color:#159cff;
}

.hero p{
max-width:650px;
color:#b8c7d5;
margin:20px 0 30px;
}

.buttons{
display:flex;
flex-wrap:wrap;
gap:12px;
}

.btn{
display:inline-block;
padding:13px 25px;
border-radius:12px;
text-decoration:none;
font-weight:bold;
transition:.25s;
}

.btn-primary{
background:#078cf0;
color:#fff;
box-shadow:0 8px 30px rgba(0,140,240,.25);
}

.btn-primary:hover{
transform:translateY(-3px);
}

.btn-outline{
border:1px solid #31617f;
color:#fff;
}

section{
padding:75px 0;
}

.section-title{
text-align:center;
margin-bottom:40px;
}

.section-title h2{
font-size:30px;
margin-bottom:8px;
}

.section-title p{
color:#91a5b8;
}

/* برندها */

.brands{
display:grid;
grid-template-columns:repeat(6,1fr);
gap:15px;
}

.brand-card{
height:120px;
background:rgba(255,255,255,.055);
border:1px solid rgba(255,255,255,.09);
border-radius:18px;
display:flex;
align-items:center;
justify-content:center;
cursor:pointer;
transition:.3s;
padding:15px;
}

.brand-card:hover,
.brand-card.active{
transform:translateY(-5px);
border-color:#149cff;
background:rgba(20,156,255,.10);
box-shadow:0 10px 35px rgba(0,130,230,.15);
}

.brand-card img{
max-width:100%;
max-height:70px;
object-fit:contain;
}

/* فیلتر */

.filters{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:10px;
margin-bottom:35px;
}

.filter-btn{
background:#0d1c2a;
color:#d9e4ed;
border:1px solid #294357;
border-radius:10px;
padding:10px 20px;
cursor:pointer;
}

.filter-btn.active{
background:#098fe9;
border-color:#098fe9;
color:white;
}

/* محصولات */

.products{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:22px;
}

.product{
background:rgba(255,255,255,.055);
border:1px solid rgba(255,255,255,.08);
border-radius:20px;
overflow:hidden;
transition:.3s;
}

.product:hover{
transform:translateY(-6px);
border-color:#159cff;
}

.product-image{
height:220px;
background:#081521;
display:flex;
align-items:center;
justify-content:center;
overflow:hidden;
}

.product-image img{
width:100%;
height:100%;
object-fit:cover;
}

.product-content{
padding:20px;
}

.product-content h3{
margin-bottom:10px;
}

.specs{
color:#9db0c0;
font-size:13px;
}

.specs div{
margin:4px 0;
}

.price{
margin-top:15px;
color:#48b6ff;
font-weight:bold;
}

/* قطعات */

.parts{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:15px;
}

.part{
background:#0b1824;
border:1px solid #1a3449;
border-radius:15px;
padding:22px 12px;
text-align:center;
transition:.3s;
}

.part:hover{
border-color:#159cff;
transform:translateY(-4px);
}

.part-icon{
font-size:35px;
margin-bottom:8px;
}

.part p{
color:#aebdca;
font-size:13px;
}

/* خدمات */

.services{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
}

.service{
padding:30px;
border-radius:20px;
background:linear-gradient(145deg,#0d2436,#08121c);
border:1px solid #1a3a51;
}

.service h3{
margin:12px 0;
}

.service p{
color:#aab8c5;
font-size:14px;
}

/* رزرو */

.booking{
background:linear-gradient(145deg,#0b2941,#07131e);
border:1px solid #194967;
border-radius:25px;
padding:35px;
}

.form-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
}

input,
select,
textarea{
width:100%;
padding:14px;
border-radius:10px;
border:1px solid #294456;
background:#07121c;
color:white;
outline:none;
}

textarea{
min-height:120px;
resize:vertical;
}

.full{
grid-column:1/-1;
}

.time-slots{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
}

.time-slot{
padding:12px;
border:1px solid #315169;
background:#091722;
border-radius:10px;
color:white;
cursor:pointer;
}

.time-slot:hover{
border-color:#159cff;
}

.time-slot.selected{
background:#098fe9;
border-color:#098fe9;
}

/* تماس */

.contact-box{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.contact-card{
padding:30px;
background:#091722;
border:1px solid #19394f;
border-radius:20px;
}

.contact-card p{
margin:12px 0;
color:#b3c2ce;
}

footer{
padding:30px 0;
text-align:center;
color:#708596;
border-top:1px solid rgba(255,255,255,.07);
}

/* موبایل */

@media(max-width:900px){

.brands{
grid-template-columns:repeat(3,1fr);
}

.products{
grid-template-columns:repeat(2,1fr);
}

.parts{
grid-template-columns:repeat(3,1fr);
}

.services{
grid-template-columns:1fr;
}

.hero h1{
font-size:38px;
}
}

@media(max-width:600px){

nav{
display:none;
}

.brands{
grid-template-columns:repeat(2,1fr);
}

.products{
grid-template-columns:1fr;
}

.parts{
grid-template-columns:repeat(2,1fr);
}

.contact-box{
grid-template-columns:1fr;
}

.form-grid{
grid-template-columns:1fr;
}

.full{
grid-column:auto;
}

.time-slots{
grid-template-columns:repeat(2,1fr);
}

.hero{
min-height:500px;
}

.hero h1{
font-size:32px;
}
}
</style>
</head>

<body>

<header>
<div class="container nav">

<div class="logo">
KEL<span>VIN</span>
</div>

<nav>
<a href="#brands">کولرها</a>
<a href="#products">محصولات</a>
<a href="#parts">قطعات</a>
<a href="#services">خدمات</a>
<a href="#booking">رزرو نصب</a>
<a href="#contact">تماس</a>
</nav>

</div>
</header>

<section class="hero">

<div class="container hero-content">

<div class="badge">
فروش • نصب • سرویس کولر گازی
</div>

<h1>
هوای خنک و مطمئن با
<span>KELVIN</span>
</h1>

<p>
فروش انواع کولر گازی، اجرای لوله‌کشی مسی،
نصب و سرویس کامل کولر گازی با کیفیت حرفه‌ای.
</p>

<div class="buttons">

<a class="btn btn-primary" href="#brands">
مشاهده کولرها
</a>

<a class="btn btn-outline" href="#booking">
درخواست نصب
</a>

</div>

</div>
</section>


<!-- انتخاب برند -->

<section id="brands">

<div class="container">

<div class="section-title">

<h2>انتخاب برند</h2>

<p>
برای مشاهده محصولات، لوگوی برند موردنظر را انتخاب کنید
</p>

</div>

<div class="brands">

<div class="brand-card active" onclick="filterBrand('all',this)">
<img src="logos/all.png" alt="">
</div>

<div class="brand-card" onclick="filterBrand('general-gold',this)">
<img src="logos/general-gold.png" alt="">
</div>

<div class="brand-card" onclick="filterBrand('gree',this)">
<img src="logos/gree.png" alt="">
</div>

<div class="brand-card" onclick="filterBrand('general-shekar',this)">
<img src="logos/general-shekar.png" alt="">
</div>

<div class="brand-card" onclick="filterBrand('lg',this)">
<img src="logos/lg.png" alt="">
</div>

<div class="brand-card" onclick="filterBrand('hisense',this)">
<img src="logos/hisense.png" alt="">
</div>

<div class="brand-card" onclick="filterBrand('tcl',this)">
